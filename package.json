{
  "name": "vaultex",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-next"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace=frontend-next run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend-next run build",
    "test:backend": "npm --workspace=backend test -- --runTestsByPath tests/auth.test.ts",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
